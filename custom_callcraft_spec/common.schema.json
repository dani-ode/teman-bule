{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "text": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "state": {"enum": ["new", "learning", "review", "mastered"]},
    "resource": {
      "type": "object", "additionalProperties": false,
      "properties": {"resource_id": {"$ref": "#/$defs/id"}, "resource_version": {"$ref": "#/$defs/version"}},
      "required": ["resource_id", "resource_version"]
    },
    "range": {
      "type": "object", "additionalProperties": false,
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}},
      "required": ["start", "end"]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "code": {"enum": ["INVALID_ARGUMENT", "UNAUTHENTICATED", "FORBIDDEN", "RESOURCE_NOT_FOUND", "STATE_CONFLICT", "IDEMPOTENCY_CONFLICT", "RATE_LIMITED", "DEPENDENCY_UNAVAILABLE", "INTERNAL"]},
        "message": {"$ref": "#/$defs/text"}, "request_id": {"$ref": "#/$defs/id"}
      },
      "required": ["code", "message", "request_id"]
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1"}, "execution_context_token": {"$ref": "#/$defs/text"},
        "request_id": {"$ref": "#/$defs/id"}, "idempotency_key": {"$ref": "#/$defs/id"}, "arguments": {"type": "object"}
      },
      "required": ["schema_version", "execution_context_token", "request_id", "arguments"]
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1"}, "execution_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["succeeded", "failed"]}, "result": {"type": ["object", "null"]},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
      },
      "required": ["schema_version", "execution_id", "status", "result", "error"],
      "oneOf": [
        {"properties": {"status": {"const": "succeeded"}, "result": {"type": "object"}, "error": {"type": "null"}}},
        {"properties": {"status": {"const": "failed"}, "result": {"type": "null"}, "error": {"$ref": "#/$defs/error"}}}
      ]
    }
  }
}
