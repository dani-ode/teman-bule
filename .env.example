# Blueprint v3. Copy locally; secret values intentionally empty.
# Numeric values provided are local-development settings, not approved production policy.
# See .blueprint/environment.md for feature dependencies and required empty values.
APP_ENV=development
APP_NAME=temanbule-backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
APP_TRUSTED_PROXY_IPS=127.0.0.1
APP_ENABLE_DOCS=true
APP_MAX_REQUEST_BYTES=1048576
APP_INTERNAL_BASE_URL=

FEATURE_AI_ENABLED=true
FEATURE_LEARN_ENABLED=false
FEATURE_TOEFL_ENABLED=false
FEATURE_MEDIA_ENABLED=false
FEATURE_REALTIME_CALL_ENABLED=false
FEATURE_OTEL_ENABLED=false
FEATURE_GOOGLE_AUTH_ENABLED=false
FEATURE_BILLING_ENABLED=false
FEATURE_ADVANCE_ENABLED=false
FEATURE_VIDEO_CALL_ENABLED=false
FEATURE_PODCAST_ENABLED=false
FEATURE_DUAL_EMBEDDING_ENABLED=false

POSTGRES_DB=temanbule
